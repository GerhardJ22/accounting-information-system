// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 1. USERS
model User {
  id           Int    @id @default(autoincrement())
  username     String @unique @db.VarChar(100)
  passwordHash String @map("password_Hash") @db.VarChar(255)
  email        String @unique @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile      UserProfile?
  customers    Customer[]
  suppliers    Supplier[]
  accounts     Account[]
  transactions Transaction[]
  invoices     Invoice[]

  @@map("USERS")
}

// 2. USER_PROFILES
model UserProfile {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique @map("user_id")
  companyName String  @map("company_name") @db.VarChar(150)
  taxId       String? @map("tax_id") @db.VarChar(100)
  currency    String  @db.VarChar(10)

  user User @relation(fields: [userId], references: [id])

  @@map("USER_PROFILES")
}

// 3. CUSTOMERS
model Customer {
  id            Int     @id @default(autoincrement())
  userId        Int     @map("user_id")
  name          String  @db.VarChar(150)
  email         String? @db.VarChar(255)
  contactNumber String? @map("contact_number") @db.VarChar(30)
  address       String? @db.Text

  user         User          @relation(fields: [userId], references: [id])
  invoices     Invoice[]
  transactions Transaction[]

  @@map("CUSTOMERS")
}

// 4. SUPPLIERS
model Supplier {
  id            Int     @id @default(autoincrement())
  userId        Int     @map("user_id")
  companyName   String  @map("company_name") @db.VarChar(150)
  email         String? @db.VarChar(255)
  contactNumber String? @map("contact_number") @db.VarChar(30)
  address       String? @db.Text

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@map("SUPPLIERS")
}

// 5. ACCOUNTS
model Account {
  id          Int    @id @default(autoincrement())
  userId      Int    @map("user_id")
  accountName String @map("account_name") @db.VarChar(100)
  accountType String @map("account_type") @db.VarChar(50)

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@map("ACCOUNTS")
}

// 6. TRANSACTIONS
model Transaction {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  accountId       Int      @map("account_id")
  customerId      Int?     @map("customer_id")
  supplierId      Int?     @map("supplier_id")
  invoiceId       Int?     @unique @map("invoice_id")
  type            String   @db.VarChar(20)
  amount          Decimal  @db.Decimal(12, 2)
  paymentMethod   String?  @map("payment_method") @db.VarChar(30)
  transactionDate DateTime @map("transaction_date") @db.Date
  category        String   @db.VarChar(100)
  description     String?  @db.Text

  user     User      @relation(fields: [userId], references: [id])
  account  Account   @relation(fields: [accountId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id])

  @@map("TRANSACTIONS")
}

// 7. INVOICES
model Invoice {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  customerId    Int      @map("customer_id")
  invoiceNumber String   @map("invoice_number") @db.VarChar(50)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(12, 2)
  status        String   @db.VarChar(20)
  issueDate     DateTime @map("issue_date") @db.Date
  dueDate       DateTime @map("due_date") @db.Date

  user        User          @relation(fields: [userId], references: [id])
  customer    Customer      @relation(fields: [customerId], references: [id])
  items       InvoiceItem[]
  transaction Transaction?

  @@unique([userId, invoiceNumber])
  @@map("INVOICES")
}

// 8. INVOICE_ITEMS
model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int     @map("invoice_id")
  description String  @db.VarChar(255)
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("INVOICE_ITEMS")
}
